{
  "compilerOptions": {
    "lib": ["es2023"],
    "strict": true,
    "strictFunctionTypes": true,
    "noEmitOnError": true,
    "alwaysStrict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "esModuleInterop": true,
    "target": "es2023",
    "noImplicitAny": true,
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "outDir": "dist",
    "noUnusedLocals": true,
    "noImplicitReturns": false,
    "strictNullChecks": true,
    "rootDir": "src",
    "inlineSources": true
  },
  "include": ["src/**/*"]
}
