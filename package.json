{
  "name": "ffmpeg-batch",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "watch": "DEBUG=ffmpeg* nodemon dist/server.js",
    "watch-ts": "tsc -w",
    "build": "rm -rf ./dist && tsc",
    "test": "npm run build:test && NODE_ENV=test c8 mocha \"dist-test/test/**/*.test.js\"",
    "build:test": "tsc -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlaflamm/ffmpeg-batch.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mlaflamm/ffmpeg-batch/issues"
  },
  "homepage": "https://github.com/mlaflamm/ffmpeg-batch#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "filesize": "^11.0.26",
    "morgan": "^1.12.1",
    "ms": "^2.1.3",
    "myzod": "^1.12.1",
    "p-map": "^7.1.1",
    "pretty-ms": "^10.0.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/touch": "^3.1.5",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "prettier": "^2.1.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "touch": "^3.1.1",
    "typescript": "^7.0.2"
  },
  "mocha": {
    "timeout": 5000
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "c8": {
    "all": true,
    "src": [
      "dist-test/src"
    ],
    "include": [
      "**/src/**"
    ],
    "exclude": [
      "**/test/**"
    ],
    "reporter": [
      "html",
      "text",
      "json-summary"
    ]
  }
}
